# Copy this file to config.env and edit paths for the target machine.

MODEL=/opt/data/model/DeepSeek-R1-Distill-Qwen-1.5B/
HOST=127.0.0.1
PORT=8000

# Experiment loop.
RUNS=20
BENCH_ROUNDS_PER_SERVE=2
NUM_PROMPTS=10
GOOD_TPOT_MS=13.7
BAD_TPOT_MS=14.1

# CPU and NUMA layout used to launch and bind vLLM.
CORES=4-31
NUMA_NODE=0
API_IO_MASK=4-7
API_GARBAGE_MASK=16-31
ENGINE_INITIAL_MASK=9-15
ENGINE_WORKER_MASK=16-20
ENGINE_MAIN_CORE=8
API_CUDA_CORE=16
ENGINE_CUDA_CORE=9
ENGINE_ZMQ_REAPER_CORE=10
ENGINE_ZMQ_IO0_CORE=11
ENGINE_ZMQ_IO1_CORE=12
ENGINE_TCPSTORE_CORE=13
ENGINE_CUDA_EVT_CORE=14

# Existing environment setup can be sourced before launch.
EXTRA_ENV_FILE=/opt/data/config.sh
VLLM_TMP_LOG=/opt/data/.vllm.serv.tmp

# Startup environment from the current manual flow.
MALLOC_CONF=lg_tcache_max:16,dirty_decay_ms:-1,muzzy_decay_ms:-1,thp:always,metadata_thp:always,tcache:true
LD_PRELOAD_EXTRA=/opt/data/tool_install/BiShengCompiler-5.1.0-aarch64-linux/lib/libstringlib.so:/opt/data/tool_install/jemalloc-5.3.0-64k-2m-gcc-11.4.0/lib/libjemalloc.so
OMP_NUM_THREADS=4
OMP_WAIT_POLICY=PASSIVE
OMP_PROC_BIND=true
OMP_PLACES=cores
MKL_NUM_THREADS=4
OPENBLAS_NUM_THREADS=4
NUMEXPR_NUM_THREADS=4
PYTHONGC=disable
gc_disable=1

# Timing.
SERVER_READY_TIMEOUT_SEC=600
PID_WAIT_TIMEOUT_SEC=600
KV_CACHE_WAIT_SEC=120
POST_LIGHT_WARMUP_SLEEP_SEC=3
POST_REP_WARMUP_SLEEP_SEC=3
POST_FINAL_BIND_SLEEP_SEC=2
BENCH_SNAPSHOT_DELAY_SEC=10
BETWEEN_RUN_SLEEP_SEC=10
SHUTDOWN_GRACE_SEC=15
COLLECTOR_WAIT_TIMEOUT_SEC=180

# Set to 1 when validating whether representative warmup removes first-round state changes.
REPRESENTATIVE_WARMUP=1
REP_WARMUP_PROMPT_WORDS=1000
REP_WARMUP_MAX_TOKENS=256

# Per-benchmark evidence collectors. Each enabled collector writes under
# rounds/round_N/evidence/<collector_name>/.
COLLECT_PIDSTAT=1
COLLECT_GPU_WATCH=1
COLLECT_PERF_SCHED=0
COLLECT_PERF_ENGINE=0
COLLECT_SNAPSHOT_DURING=1
COLLECT_NVIDIA_Q=1
PIDSTAT_DURATION_SEC=120
GPU_WATCH_DURATION_SEC=120
PERF_SCHED_DURATION_SEC=20
PERF_ENGINE_DURATION_SEC=60
SNAPSHOT_DURING_DELAY_SEC=10
NVIDIA_Q_DURATION_SEC=0
PERF_FREQ=99

# Benchmark command. Placeholders are replaced by run_experiment.sh.
BENCH_CMD_TEMPLATE='vllm bench serve --backend vllm --model "{MODEL}" --endpoint /v1/completions --host {HOST} --port {PORT} --dataset-name random --random-input-len 1023 --random-output-len 512 --num-prompts {NUM_PROMPTS} --request-rate inf --max-concurrency 1 --temperature 0.0'

# Extra args for vllm serve.
SERVE_EXTRA_ARGS='--trust-remote-code --max-model-len 4000 --max-num-seqs 1 --max-num-batched-tokens 8000 --enforce-eager --no-enable-prefix-caching --dtype bfloat16 --disable-log-stats'
